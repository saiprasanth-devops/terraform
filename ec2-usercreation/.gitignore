# Local .terraform directories (contains provider binaries)
**/.terraform/*

# .tfstate files (contains sensitive plain-text secrets and infrastructure state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all variable files as they often contain secrets/passwords
*.tfvars
*.tfvars.json

# Exclude override files (used for local modifications)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control
# !example_override.tf

# CLI configuration files
.terraformrc
terraform.rc
